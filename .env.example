# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# DATABASE_URL:
# Local zero-config (SQLite):
DATABASE_URL="file:./dev.db"
# Production / Cloud SQL (PostgreSQL) — also set provider = "postgresql" in prisma/schema.prisma:
# DATABASE_URL="postgresql://user:password@host:5432/nagriksetu?schema=public"

# JWT_SECRET: Secret used to sign authentication tokens. Use a long random string in production.
JWT_SECRET="replace-me-with-a-long-random-secret-string"

# JWT_TTL_HOURS: How long auth tokens are valid (default 24 hours).
JWT_TTL_HOURS=24
